# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Groq: Whisper (voice -> text), Llama 3.3 (structuring), Llama vision (photos)
GROQ_API_KEY=

# Notion internal integration token; share the target page/database with it
NOTION_TOKEN=
NOTION_PROJECTS_PAGE_ID=
NOTION_TASKS_DB_ID=

# Obsidian vault; "About Me.md" / "Home.md" are read once as LLM context
OBSIDIAN_VAULT=

# Comma-separated Telegram user IDs allowed to use the bot (required)
ALLOWED_USER_IDS=
